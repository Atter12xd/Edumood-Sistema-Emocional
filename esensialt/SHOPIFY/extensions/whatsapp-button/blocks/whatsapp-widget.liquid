{% comment %} SCRIPT PRINCIPAL - Control de horarios con JavaScript {% endcomment %}
<script>
// FUNCIÓN PRINCIPAL: Verificar si widget está activo según horarios REALES
function isWidgetActiveNow() {
  // Si está configurado para 24 horas, siempre activo
  const isActive24Hours = '{{ is_active_24_hours }}';
  console.log('🕐 Configuración 24 horas:', isActive24Hours);
  
  if (isActive24Hours === 'true') {
    console.log('✅ Widget activo: Configurado para 24 horas');
    return true;
  }
  
  // Usar JavaScript para obtener tiempo REAL del usuario
  const now = new Date();
  
  // CORRECCIÓN: Usar 'long' en lugar de 'lowercase'
  const currentDay = now.toLocaleDateString('en-US', { weekday: 'long' }).toLowerCase();
  const currentHour = now.getHours();
  const currentMinute = now.getMinutes();
  const currentTime = currentHour * 100 + currentMinute;
  
  console.log('🕐 Tiempo REAL del usuario:', {
    day: currentDay,
    hour: currentHour,
    minute: currentMinute,
    timeNumber: currentTime,
    fullDate: now.toString()
  });
  
  // Verificar si hoy está en los días activos
  const activeDays = '{{ active_days }}';
  const daysArray = activeDays.split(',').map(day => day.trim()).filter(day => day);
  
  console.log('📅 Días activos configurados:', daysArray);
  console.log('📅 Día actual:', currentDay);
  
  if (!daysArray.includes(currentDay)) {
    console.log('❌ Widget inactivo: Día no permitido');
    return false;
  }
  
  // Verificar horario
  const startTime = '{{ start_time }}';
  const endTime = '{{ end_time }}';
  
  if (startTime && endTime) {
    // Convertir horarios a números para comparación
    const startParts = startTime.split(':');
    const endParts = endTime.split(':');
    const startTimeNumber = parseInt(startParts[0]) * 100 + parseInt(startParts[1]);
    const endTimeNumber = parseInt(endParts[0]) * 100 + parseInt(endParts[1]);
    
    console.log('🕐 Horarios configurados:', {
      start: startTime,
      end: endTime,
      startNumber: startTimeNumber,
      endNumber: endTimeNumber,
      current: currentTime
    });
    
    // NUEVA LÓGICA: Manejar horarios que cruzan medianoche
    if (startTimeNumber > endTimeNumber) {
      // Horario nocturno (ej: 21:00 - 05:55)
      const isActive = currentTime >= startTimeNumber || currentTime <= endTimeNumber;
      console.log(isActive ? '✅ Widget activo: Horario nocturno' : '❌ Widget inactivo: Fuera de horario nocturno');
      return isActive;
    } else {
      // Horario normal (ej: 09:00 - 18:00)
      const isActive = currentTime >= startTimeNumber && currentTime <= endTimeNumber;
      console.log(isActive ? '✅ Widget activo: Horario normal' : '❌ Widget inactivo: Fuera de horario normal');
      return isActive;
    }
  }
  
  // Si no hay horarios configurados, asumir que está activo
  console.log('⚠️ Sin horarios configurados, widget activo por defecto');
  return true;
}

// Función para mostrar notificación de horario
function showScheduleNotification() {
  const notification = document.createElement('div');
  notification.id = 'whatsapp-schedule-notification';
  notification.style.cssText = `
    position: fixed;
    {% case position %}
      {% when 'top-left' %}
        top: 90px;
        left: 20px;
      {% when 'top-right' %}
        top: 90px;
        right: 20px;
      {% when 'bottom-left' %}
        bottom: 90px;
        left: 20px;
      {% when 'bottom-right' %}
        bottom: 90px;
        right: 20px;
      {% else %}
        bottom: 90px;
        right: 20px;
    {% endcase %}
    z-index: 10000;
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: white;
    padding: 16px 20px;
    border-radius: 16px;
    font-size: 14px;
    font-weight: 600;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    max-width: 280px;
    text-align: center;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s ease;
    border: 2px solid rgba(255,255,255,0.2);
  `;
  
  const startTime = '{{ start_time }}';
  const endTime = '{{ end_time }}';
  
  notification.innerHTML = `
    <div style="display: flex; align-items: center; gap: 12px;">
      <div style="font-size: 24px;">🕐</div>
      <div>
        <div style="font-size: 16px; font-weight: 700;">Fuera de horario</div>
        <div style="font-size: 13px; opacity: 0.9;">Horario de atención:</div>
        <div style="font-size: 14px; font-weight: 700; margin-top: 4px;">${startTime} - ${endTime}</div>
        {% if shop_owner_first_name != blank %}
        <div style="font-size: 12px; opacity: 0.8; margin-top: 4px;">Propietario: {{ shop_owner_first_name }} {{ shop_owner_last_name }}</div>
        {% endif %}
      </div>
    </div>
  `;
  
  document.body.appendChild(notification);
  
  // Animar entrada
  setTimeout(() => {
    notification.style.opacity = '1';
    notification.style.transform = 'translateY(0)';
  }, 10);
  
  // Remover después de 4 segundos
  setTimeout(() => {
    notification.style.opacity = '0';
    notification.style.transform = 'translateY(-20px)';
    setTimeout(() => {
      if (notification.parentNode) {
        notification.parentNode.removeChild(notification);
      }
    }, 400);
  }, 4000);
}

// Verificar horarios al cargar el script
const isCurrentlyActive = isWidgetActiveNow();
console.log('🕐 Estado del widget según horarios REALES:', isCurrentlyActive ? 'ACTIVO' : 'INACTIVO');

// FUNCIÓN PRINCIPAL DE ROTACIÓN AUTOMÁTICA CON ENDPOINT
async function abrirWhatsAppConRotacion() {
  console.log('🚀 BOTÓN CLICKEADO - Función ejecutada');
  
  if (!isWidgetActiveNow()) {
    console.log('❌ Fuera de horario');
    showScheduleNotification();
    return;
  }

  // SISTEMA DE ROTACIÓN AUTOMÁTICA CON ENDPOINT
  try {
    console.log('🔄 === INICIANDO SISTEMA DE ROTACIÓN AUTOMÁTICA ===');
    
    // Llamar al endpoint de rotación
    const shopId = 'gid://shopify/Shop/{{ shop.id }}';
    const shopIdEncoded = encodeURIComponent(shopId);
    const endpoint = `https://essent-backen-production.up.railway.app/whatsapp/siguiente/${shopIdEncoded}`;
    
    console.log('📡 Endpoint de rotación:', endpoint);
    console.log('🏪 Shop ID completo:', shopId);
    
    const response = await fetch(endpoint, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      }
    });
    
    console.log('📡 Status de respuesta:', response.status);
    
    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }
    
    const data = await response.json();
    console.log('📊 Respuesta del endpoint de rotación:', data);
    
    // Extraer número del endpoint (múltiples propiedades posibles)
    const numeroObtenido = data.numero || data.phone || data.telefono || null;
    
    if (numeroObtenido) {
      console.log('📱 Número obtenido de la rotación:', numeroObtenido);
      console.log('🎯 Fuente: ENDPOINT DE ROTACIÓN AUTOMÁTICA');
      
      // Construir URL con número del endpoint
      const mensaje = encodeURIComponent('{{ message | escape }}');
      const url = `https://wa.me/${numeroObtenido.replace(/\s/g, '')}?text=${mensaje}`;
      
      console.log('🔗 URL final con rotación:', url);
      console.log('🚀 Abriendo WhatsApp con ROTACIÓN AUTOMÁTICA');
      console.log('📊 Información del propietario:', window.shopOwnerInfo);
      
      // Abrir WhatsApp
      {% if block.settings.open_in_new_tab %}
        window.open(url, '_blank');
      {% else %}
        window.location.href = url;
      {% endif %}
      
      return;
    } else {
      throw new Error('No se encontró número en la respuesta del endpoint');
    }
    
  } catch (error) {
    console.log('❌ Error en sistema de rotación:', error);
    console.log('🔄 Usando fallback del metafield');
    
    // Fallback: usar número del metafield
    const numeroFallback = '{{ phone_number }}';
    const mensaje = encodeURIComponent('{{ message | escape }}');
    const urlFallback = `https://wa.me/${numeroFallback}?text=${mensaje}`;
    
    console.log('🔗 URL fallback:', urlFallback);
    console.log('🎯 Fuente: FALLBACK DEL METAFIELD');
    console.log('📊 Información del propietario (fallback):', window.shopOwnerInfo);
    
    // Abrir WhatsApp con fallback
    {% if block.settings.open_in_new_tab %}
      window.open(urlFallback, '_blank');
    {% else %}
      window.location.href = urlFallback;
    {% endif %}
  }
}
</script>

