{% raw %}
<script>
const RAILWAY_API_URL = 'https://essent-backen-production.up.railway.app/cod-forms';
const SHOP_ID = window.COD_SHOP_ID || 'gid://shopify/Shop/69894897821';
let codFormConfig = null;

console.log('🚀 COD Modal Script Cargado');

async function loadModalConfig() {
  try {
    console.log('📡 Cargando config para modal...');
    
    const response = await fetch(
      RAILWAY_API_URL + '?idusuarios=' + encodeURIComponent(SHOP_ID),
      {
        method: 'GET',
        headers: { 'Content-Type': 'application/json' }
      }
    );
    
    if (!response.ok) {
      console.warn('⚠️ Error:', response.status);
      return null;
    }
    
    const result = await response.json();
    
    if (result.success && result.data && result.data.length > 0) {
      const existingForm = result.data[0];
      const loadedConfig = existingForm.form_config;
      loadedConfig.product_image = existingForm.product_image;
      
      console.log('✅ Config cargada:', loadedConfig);
      console.log('🖼️ product_image:', existingForm.product_image);
      
      return loadedConfig;
    }
    
    return null;
    
  } catch (error) {
    console.error('❌ Error:', error);
    return null;
  }
}

function applyModalStyles(config) {
  if (!config) {
    console.warn('⚠️ No hay config');
    return;
  }
  
  console.log('🎨 Aplicando estilos desde Railway...');
  
  const modal = document.getElementById('codModalContainer');
  const inputs = document.querySelectorAll('.cod-input');
  const btn = document.getElementById('codSubmitBtn');
  const btnText = document.getElementById('codBtnText');
  const productImage = document.getElementById('codProductImage');
  
  // Product Image
  if (config.product_image && productImage) {
    console.log('🖼️ Aplicando product_image:', config.product_image);
    
    if (config.product_image.startsWith('http://') || config.product_image.startsWith('https://')) {
      productImage.innerHTML = '<img src="' + config.product_image + '" alt="Producto">';
      console.log('   ✓ URL aplicada');
    } else {
      productImage.innerHTML = '<div class="cod-product-placeholder" style="font-size: 36px;">' + config.product_image + '</div>';
      console.log('   ✓ Emoji aplicado');
    }
  }
  
  // Form Style
  if (config.formStyle && modal) {
    const fs = config.formStyle;
    if (fs.backgroundColor) modal.style.backgroundColor = fs.backgroundColor;
    if (fs.borderRadius) modal.style.borderRadius = fs.borderRadius + 'px';
    if (fs.borderWidth && fs.borderColor) modal.style.border = fs.borderWidth + 'px solid ' + fs.borderColor;
    if (fs.shadow) modal.style.boxShadow = '0 ' + fs.shadow + 'px ' + (fs.shadow * 2) + 'px rgba(0,0,0,0.3)';
  }
  
  // Block Colors
  if (config.blockColors && inputs.length > 0) {
    const bc = config.blockColors;
    inputs.forEach(function(input) {
      if (bc.textColor) input.style.color = bc.textColor;
      if (bc.bgColor) input.style.backgroundColor = bc.bgColor;
      if (bc.borderRadius) input.style.borderRadius = bc.borderRadius + 'px';
      if (bc.borderWidth && bc.borderColor) {
        input.style.borderWidth = bc.borderWidth + 'px';
        input.style.borderColor = bc.borderColor;
      }
      if (bc.textSize) input.style.fontSize = bc.textSize + 'px';
    });
  }
  
  // Button Config (buscar en buttonConfig O blocks.submitButton)
  if (config.buttonConfig && btn) {
    const btc = config.buttonConfig;
    if (btc.text && btnText) btnText.textContent = btc.text;
    if (btc.bgColor) btn.style.background = btc.bgColor;
    if (btc.textColor) btn.style.color = btc.textColor;
    if (btc.textSize) btn.style.fontSize = btc.textSize + 'px';
    if (btc.borderRadius) btn.style.borderRadius = btc.borderRadius + 'px';
    if (btc.borderWidth && btc.borderColor) {
      btn.style.borderWidth = btc.borderWidth + 'px';
      btn.style.borderStyle = 'solid';
      btn.style.borderColor = btc.borderColor;
    }
    if (btc.shadow) btn.style.boxShadow = '0 ' + btc.shadow + 'px ' + (btc.shadow * 2) + 'px rgba(0,0,0,0.3)';
    console.log('✅ Estilos aplicados desde buttonConfig');
  } else if (config.blocks && config.blocks.submitButton && btn) {
    // Si buttonConfig es null, buscar en blocks.submitButton
    const sb = config.blocks.submitButton;
    console.log('📝 Usando blocks.submitButton:', sb);
    
    if (sb.label && btnText) {
      btnText.textContent = sb.label;
      console.log('   ✓ label:', sb.label);
    }
    if (sb.bgColor) {
      btn.style.background = sb.bgColor;
      console.log('   ✓ bgColor:', sb.bgColor);
    }
    if (sb.textColor) {
      btn.style.color = sb.textColor;
      console.log('   ✓ textColor:', sb.textColor);
    }
    if (sb.textSize) {
      btn.style.fontSize = sb.textSize + 'px';
      console.log('   ✓ textSize:', sb.textSize);
    }
    if (sb.borderRadius) {
      btn.style.borderRadius = sb.borderRadius + 'px';
      console.log('   ✓ borderRadius:', sb.borderRadius);
    }
    if (sb.borderWidth && sb.borderColor) {
      btn.style.borderWidth = sb.borderWidth + 'px';
      btn.style.borderStyle = 'solid';
      btn.style.borderColor = sb.borderColor;
      console.log('   ✓ border:', sb.borderWidth, sb.borderColor);
    }
    console.log('✅ Estilos aplicados desde blocks.submitButton');
  }
  
  console.log('✅ Estilos aplicados');
}

async function openCODModal() {
  console.log('🚀 Abriendo modal...');
  const modal = document.getElementById('codFormModal');
  
  if (!modal) {
    console.error('❌ Modal no encontrado');
    return;
  }
  
  modal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
  
  if (!codFormConfig) {
    codFormConfig = await loadModalConfig();
    applyModalStyles(codFormConfig);
  }
}

function closeCODModal() {
  const modal = document.getElementById('codFormModal');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = 'auto';
  }
}

async function handleCODSubmit(event) {
  event.preventDefault();
  
  const btn = document.getElementById('codSubmitBtn');
  const btnText = document.getElementById('codBtnText');
  const btnLoader = document.getElementById('codBtnLoader');
  const btnArrow = btn.querySelector('.cod-btn-arrow');
  
  btn.disabled = true;
  btnText.style.display = 'none';
  if (btnArrow) btnArrow.style.display = 'none';
  btnLoader.style.display = 'inline-block';
  
  try {
    const formData = new FormData(event.target);
    const data = {};
    formData.forEach(function(value, key) {
      data[key] = value;
    });
    
    console.log('📦 Datos:', data);
    
    await new Promise(function(resolve) {
      setTimeout(resolve, 2000);
    });
    
    alert('✅ ¡Pedido realizado exitosamente!');
    closeCODModal();
    event.target.reset();
    
  } catch (error) {
    console.error('❌ Error:', error);
    alert('❌ Error al procesar el pedido');
  } finally {
    btn.disabled = false;
    btnText.style.display = 'inline';
    if (btnArrow) btnArrow.style.display = 'inline';
    btnLoader.style.display = 'none';
  }
}

document.addEventListener('click', function(e) {
  if (e.target.id === 'codFormModal') {
    closeCODModal();
  }
});
</script>

<script>
(function() {
  console.log('🔥 Sistema de eliminación activado');
  
  function destruirBotonesNegros() {
    let destruidos = 0;
    
    document.querySelectorAll('button').forEach(function(btn) {
      if (btn.id === 'codDynamicButton' || 
          btn.classList.contains('cod-payment-button') ||
          btn.getAttribute('name') === 'add') {
        return;
      }
      
      const texto = (btn.textContent || '').toLowerCase().replace(/\s+/g, ' ').trim();
      
      if (texto.includes('buy it now') ||
          texto.includes('buy now') ||
          texto.includes('comprar ahora') ||
          (texto.includes('pagar') && texto.includes('contra') && texto.includes('reembolso'))) {
        btn.remove();
        destruidos++;
        return;
      }
      
      const bg = window.getComputedStyle(btn).backgroundColor;
      if ((bg.includes('0, 0, 0') || bg === 'black') && texto.includes('pagar')) {
        btn.remove();
        destruidos++;
      }
    });
    
    document.querySelectorAll('[class*="releasit"], [class*="Releasit"]').forEach(function(el) {
      if (el.tagName === 'BUTTON' && el.id !== 'codDynamicButton') {
        el.remove();
        destruidos++;
      }
    });
    
    document.querySelectorAll('.shopify-payment-button button').forEach(function(btn) {
      if (btn.id !== 'codDynamicButton') {
        btn.remove();
        destruidos++;
      }
    });
    
    if (destruidos > 0) {
      console.log('💥 Eliminados:', destruidos, 'botones');
    }
  }
  
  destruirBotonesNegros();
  
  let contador = 0;
  const ultraRapido = setInterval(function() {
    destruirBotonesNegros();
    contador++;
    if (contador >= 1000) {
      clearInterval(ultraRapido);
      setInterval(destruirBotonesNegros, 500);
    }
  }, 10);
  
  new MutationObserver(function() {
    setTimeout(destruirBotonesNegros, 5);
  }).observe(document.body, {
    childList: true,
    subtree: true,
    attributes: true
  });
  
  console.log('🛡️ Protección activa');
})();
</script>
