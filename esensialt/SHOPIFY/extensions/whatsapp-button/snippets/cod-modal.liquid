{% comment %}
  Snippet: cod-modal.liquid
  Modal COD - Diseño profesional con estilos desde Railway
{% endcomment %}

<div id="codFormModal" class="cod-modal-overlay" style="display: none;">
  <div class="cod-modal-container" id="codModalContainer">
    <button type="button" class="cod-close-btn" onclick="closeCODModal()" aria-label="Cerrar">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M15 5L5 15M5 5l10 10" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="cod-modal-header">
      <div class="cod-header-icon">💳</div>
      <h2 class="cod-modal-title">Pago Contra Reembolso</h2>
      <p class="cod-modal-subtitle">Completa tus datos para finalizar la compra</p>
    </div>

    <div class="cod-modal-content">
      <!-- Product Summary -->
      <div class="cod-product-card" id="codProductSummary">
        <div class="cod-product-image" id="codProductImage">
          <div class="cod-product-placeholder">📦</div>
        </div>
        <div class="cod-product-info">
          <h3 class="cod-product-name" id="codProductName">{{ product.title | default: 'Producto' }}</h3>
          <div class="cod-product-price" id="codProductPrice">{{ product.price | default: 0 | money }}</div>
        </div>
      </div>

      <!-- Price Summary -->
      <div class="cod-price-card">
        <div class="cod-price-row">
          <span class="cod-price-label">Subtotal</span>
          <span class="cod-price-value" id="codSubtotal">{{ product.price | default: 0 | money }}</span>
        </div>
        <div class="cod-price-row">
          <span class="cod-price-label">Envío</span>
          <span class="cod-price-value cod-free" id="codShipping">Gratis</span>
        </div>
        <div class="cod-price-divider"></div>
        <div class="cod-price-row cod-total-row">
          <span class="cod-total-label">Total a pagar</span>
          <span class="cod-total-value" id="codTotal">{{ product.price | default: 0 | money }}</span>
        </div>
      </div>

      <!-- Form Section -->
      <div class="cod-form-section">
        <div class="cod-section-header">
          <div class="cod-section-icon">📍</div>
          <h3 class="cod-section-title">Información de envío</h3>
        </div>

        <form id="codCheckoutForm" class="cod-form" onsubmit="handleCODSubmit(event)">
          <div class="cod-form-grid">
            <div class="cod-input-group">
              <label class="cod-input-label">
                <span class="cod-label-icon">👤</span>
                <span class="cod-label-text">Nombre</span>
              </label>
              <input type="text" name="firstName" placeholder="Ingresa tu nombre" required class="cod-input">
            </div>

            <div class="cod-input-group">
              <label class="cod-input-label">
                <span class="cod-label-icon">👤</span>
                <span class="cod-label-text">Apellido</span>
              </label>
              <input type="text" name="lastName" placeholder="Ingresa tu apellido" required class="cod-input">
            </div>

            <div class="cod-input-group">
              <label class="cod-input-label">
                <span class="cod-label-icon">📱</span>
                <span class="cod-label-text">Teléfono</span>
              </label>
              <input type="tel" name="phone" placeholder="+51 999 999 999" required class="cod-input">
            </div>

            <div class="cod-input-group">
              <label class="cod-input-label">
                <span class="cod-label-icon">📧</span>
                <span class="cod-label-text">Email</span>
              </label>
              <input type="email" name="email" placeholder="tu@email.com" required class="cod-input">
            </div>

            <div class="cod-input-group cod-full-width">
              <label class="cod-input-label">
                <span class="cod-label-icon">📍</span>
                <span class="cod-label-text">Dirección</span>
              </label>
              <input type="text" name="address" placeholder="Calle, número, interior" required class="cod-input">
            </div>

            <div class="cod-input-group">
              <label class="cod-input-label">
                <span class="cod-label-icon">🏙️</span>
                <span class="cod-label-text">Ciudad</span>
              </label>
              <input type="text" name="city" placeholder="Tu ciudad" required class="cod-input">
            </div>

            <div class="cod-input-group">
              <label class="cod-input-label">
                <span class="cod-label-icon">📌</span>
                <span class="cod-label-text">Provincia</span>
              </label>
              <input type="text" name="province" placeholder="Tu provincia" required class="cod-input">
            </div>

            <div class="cod-input-group">
              <label class="cod-input-label">
                <span class="cod-label-icon">✉️</span>
                <span class="cod-label-text">Código Postal</span>
              </label>
              <input type="text" name="postalCode" placeholder="00000" required class="cod-input">
            </div>
          </div>

          <div class="cod-terms-wrapper">
            <label class="cod-checkbox-container">
              <input type="checkbox" name="terms" required class="cod-checkbox">
              <span class="cod-checkbox-custom"></span>
              <span class="cod-checkbox-text">Acepto los <a href="#" class="cod-link">términos y condiciones</a></span>
            </label>
          </div>

          <button type="submit" class="cod-submit-btn" id="codSubmitBtn">
            <span class="cod-btn-content">
              <span id="codBtnText">REALIZAR PEDIDO</span>
              <svg class="cod-btn-arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7.5 15l5-5-5-5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span id="codBtnLoader" class="cod-loader" style="display: none;">
              <svg class="cod-spinner" width="20" height="20" viewBox="0 0 20 20">
                <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="2" fill="none" opacity="0.25"/>
                <path d="M10 2a8 8 0 018 8" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
              </svg>
            </span>
          </button>
        </form>
      </div>
    </div>

    <div class="cod-modal-footer">
      <div class="cod-security-badge">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0L2 3v5c0 3.5 2.5 6.5 6 7 3.5-.5 6-3.5 6-7V3L8 0z"/>
        </svg>
        <span>Pago seguro y protegido</span>
      </div>
    </div>
  </div>
</div>

{% raw %}
<style>
